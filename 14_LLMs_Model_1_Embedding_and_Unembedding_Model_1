\n","print(f'Variable \"tokens\" is type {type(tokens)}')\n","\n","# convert to pytorch\n","tm_tokens = torch.tensor(tokens)\n","\n","print(f'Variable \"tm_tokens\" is type {type(tm_tokens)} and has {len(tm_tokens)}')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"fUGwWPnt6YKb","executionInfo":{"status":"ok","timestamp":1778232409087,"user_tz":-120,"elapsed":315,"user":{"displayName":"Adrian K","userId":"10865832628683391308"}},"outputId":"3ce42566-8698-480e-d714-a3efab9fc316"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Variable \"tokens\" is type <class 'list'>\n","Variable \"tm_tokens\" is type <class 'torch.Tensor'> and has 43053\n"]}]},{"cell_type":"markdown","source":["## Dataset"],"metadata":{"id":"kk94INl2wUcL"}},{"cell_type":"code","source":["# create a class for a dataset\n","class TokenDataset(Dataset):\n","  def __init__(self, tokens, seq_len=8, stride=4):\n","\n","    # initialize\n","    self.inputs  = []\n","    self.targets = []\n","\n","    # overlapping sequences of seq_len\n","    for i in range(0, len(tokens)-seq_len, stride):\n","\n","      # get c tokens and append to the lists\n","      self.inputs.append( tokens[i   : i+seq_len])\n","      self.targets.append(tokens[i+1 : i+seq_len+1])\n","\n","  def __len__(self):\n","    return len(self.inputs)\n","\n","  def __getitem__(self, idx):\n","    return self.inputs[idx], self.targets[idx]\n","\n","# create an instance\n","token_dataset = TokenDataset(tm_tokens, seq_len, stride)\n","token_dataset[4]"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"DR4-nTlgwBJc","executionInfo":{"status":"ok","timestamp":1778232409278,"user_tz":-120,"elapsed":181,"user":{"displayName":"Adrian K","userId":"10865832628683391308"}},"outputId":"e41dec6c-ba10-4816-ff24-d425a7ae2dfb"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["(tensor([ 9745,    38,   469, 37725,   220,  1758, 17601,   881]),\n"," tensor([   38,   469, 37725,   220,  1758, 17601,   881,  8731]))"]},"metadata":{},"execution_count":6}]},{"cell_type":"markdown","source":["## Model"],"metadata":{"id":"mgqEVUcGUmdr"}},{"cell_type":"code","source":["class Model(nn.Module):\n","  def __init__(self):\n","    super().__init__()\n","\n","    # embedding matrix\n","    self.embedding = nn.Embedding(n_vocab, embed_dim)\n","\n","    # unembedding (linear layer)\n","    self.gelu = nn.GELU()\n","    self.final_linear = nn.Linear(embed_dim, n_vocab, bias = False)\n","\n","  def forward(self, tok_x):\n","\n","    # forward pass\n","    x = self.embedding(tok_x) # [batch, token, embed_dim]\n","    x = self.gelu(x)\n","    x = self.final_linear(x)  # [batch, token, vocab_size]\n","\n","    # note: no softmax here!\n","    return x\n","\n","  def generate(self, tok_x, n_new_tokens = 30):\n","\n","    # tok_x is [batch, tokens]\n","    for _ in range(n_new_tokens):\n","\n","      # get predictions\n","      x = self(tok_x)\n","\n","      # extract the final token to predict the next\n","      x = x[:,-1,:] # [batch, vocab_size, tokens]\n","\n","      # apply softmax to get probability values over all tokens in the vocab\n","      probs = F.softmax(x, dim = -1) # dim -1 refers to tokens\n","\n","      # probabilitstically sample from the distribution (random with probabilities from probs)\n","      tok_x_next = torch.multinomial(probs, num_samples = 1) # [batch, 1]\n","\n","      # append\n","      tok_x = torch.cat((tok_x, tok_x_next), dim = 1)\n","\n","    return tok_x"],"metadata":{"id":"IZ6YNRLd3hgJ"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## Run"],"metadata":{"id":"AHaCCbK-U3Lj"}},{"cell_type":"code","source":["# new instance of the model\n","model = Model()\n","\n","# get some data\n","X, y = token_dataset[12345]\n","\n","# process the tokens (forward pass)\n","out = model(X)\n","\n","print(X.shape)\n","print(y.shape)\n","print(out.shape) # [tokens, vocab_size]"],"metadata":{"