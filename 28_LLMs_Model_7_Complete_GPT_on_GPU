,"instead of\n","\n","```\n","q = x @ Wq.T\n","k = x @ Wk.T\n","v = x @ Wv.T\n","```\n","\n","Is way more efficient, i.e. its better to create one matrix `qkv` and split therein after."],"metadata":{"id":"txgMYhHRBEOQ"}},{"cell_type":"code","source":["class MultiHeadAttention(nn.Module):\n","  def __init__(self):\n","    super().__init__()\n","\n","    # num of attention heads\n","    self.num_heads = n_heads\n","    self.head_dim = embed_dim // n_heads\n","\n","    # the three Q,K,V weights matrices are initialized as one, and are split inside\n","    self.QKV = nn.Linear(embed_dim, 3*embed_dim, bias = True)\n","\n","    # linear mixing after attention\n","    self.W0 = nn.Linear(embed_dim, embed_dim, bias = True)\n","\n","  def forward(self, x):\n","\n","    # sizes for later use\n","    B,T,E = x.shape # [batch, seq_len, embed_dim]\n","\n","    # push data through Q, K and V in one concatenated matrix\n","    qkv = self.QKV(x) # [batch, sequence, 3*embed]\n","    q,k,v = torch.split(qkv, E, dim = 2) # each matrix is [B,T,E]\n","\n","    # reshape to [B,T,nHeads, head_dim]\n","    # and then transpose to [B, nHeads, T, head_dim] (requirement for F.scaled_dot_product_attention)\n","    q = q.view(B, T, self.num_heads, self.head_dim).transpose(1,2) # [B, nHeads, T, head_dim]\n","    k = k.view(B, T, self.num_heads, self.head_dim).transpose(1,2)\n","    v = v.view(B, T, self.num_heads, self.head_dim).transpose(1,2)\n","\n","    # PyTorch's dot-product attention function handles multi-head shapes\n","    out = F.scaled_dot_product_attention(q,k,v,is_causal=True) # [B, nHeads, T, head_dim]\n","\n","    # recombine heads: (B, nHeads, T, head_dim) -> [B,T,E] (nHeads * head_dim = embed_dim = E)\n","    out = out.transpose(1,2).view(B,T,E)\n","\n","    return out"],"metadata":{"id":"oiQHxlKk-dgx","executionInfo":{"status":"ok","timestamp":1781637004663,"user_tz":-120,"elapsed":7,"user":{"displayName":"Adrian K","userId":"10865832628683391308"}}},"execution_count":17,"outputs":[]},{"cell_type":"markdown","source":["## Test"],"metadata":{"id":"j6mwbm6FV8Y0"}},{"cell_type":"code","source":["x = torch.randn(size = (batch_size, seq_len, embed_dim), dtype = torch.float)\n","x.shape"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8tQ_1QRAC-6X","executionInfo":{"status":"ok","timestamp":1781637004686,"user_tz":-120,"elapsed":23,"user":{"displayName":"Adrian K","userId":"10865832628683391308"}},"outputId":"8e66a8d3-d4d0-4f6b-bdae-6ef012bc5751"},"execution_count":18,"outputs":[{"output_type":"execute_result","data":{"text/plain":["torch.Size([8, 1024, 768])"]},"metadata":{},"execution_count":18}]},{"cell_type":"code","source":["mha = MultiHeadAttention()\n","out = mha(x)"],"metadata":{"id":"zgH8wrIuDY62","executionInfo":{"status":"ok","timestamp":1781637004767,"user_tz":-120,"elapsed":81,"user":{"displayName":"Adrian K","userId":"10865832628683391308"}}},"execution_count":19,"outputs":[]},{"cell_type":"code","source":["_, axs = plt.subplots(1,2,figsize = (8,5))\n","\n","batch = torch.randint(0,batch_size,(1,)).item()\n","\n","axs[0].imshow(x[batch])\n","axs[0].set_title(f'x | batch: {batch}')\n","axs[0].set_xlabel('embed_dim')\n","axs[0].set_ylabel('seq_len')\n","\n","axs[1].imshow(out.detach()[batch])\n","axs[1].set_title(f'MHA | batch: {batch}')\n","axs[1].set_xlabel('embed_dim')\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":516},"id":"zlr3hl_qDvpF","executionInfo":{"status":"ok","timestamp":1781637005174,"user_tz":-120,"elapsed":406,"user":{"displayName":"Adrian K","userId":"10865832628683391308"}},"outputId":"497b398f-aa5b-4aff-f037-3936d992cb66"},"execution_count":20,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["# Transformer Block"],"metadata":{"id":"yMYUqgSNFfTB"}},{"cell_type":"markdown","source":["## Code"],"metadata":{"id":"LVlGzteAV7Qr"}},{"cell_type":"code","source":["class TransformerBlock(nn.Module):\n","  def __init__(self):\n","    super().__init__()\n","\n","    ### attention subblock\n","    self.layernorm_1 = nn.LayerNorm(embed_dim, eps=1e-5)\n","    self.attn        = MultiHeadAttention()\n","\n","    # linear feedforward (MLP) subblock\n","    self.layernorm_2 = nn.LayerNorm(embed_dim, eps = 1e-5)\n","    # 4x expansion, then back to embedding size\n","    self.mlp_1 = nn.Linear(embed_dim, 4*embed_dim, bias = True)\n","    self.gelu  = nn.GELU()\n","    self.mlp_2 = nn.Linear(4*embed_dim, embed_dim, bias = True)\n","\n","  def forward(self, x):\n","\n","    # attention\n","    x_att = self.layernorm_1(x) # pre-attention normalization\n","    x_att = x + self.attn(x_att) # run through attention, then add pre-att\n","\n","    # MLP\n","    x_ff = self.layernorm_2(x_att) # pre-MLP normalization\n","    x_ff = x_att + self.mlp_2(self.gelu(self.mlp_1(x_ff))) # adjustment from expansion\n","\n","    return x_ff"],"metadata":{"id":"V9pnN-kfF0nN","executionInfo":{"status":"ok","timestamp":1781637005176,"user_tz":-120,"elapsed":1,"user":{"displayName":"Adrian K","userId":"10865832628683391308"}}},"execution_count":21,"outputs":[]},{"cell_type":"markdown","source":["## Test"],"metadata":{"id":"Oev2dMpdV6QD"}},{"cell_type":"code","source":["mha = MultiHeadAttention()\n","transformer_block = TransformerBlock()\n","\n","out = mha(x)\n","x_ff = transformer_block(out)"],"metadata":{"id":"tQa18EamUzwE","executionInfo":{"status":"ok","timestamp":1781637005177,"user_tz":-120,"elapsed":1,"user":{"displayName":"Adrian K","userId":"10865832628683391308"}}},"execution_count":22,"outputs":[]},{"cell_type":"code","source":["_, axs = plt.subplots(1,3,figsize = (10,5))\n","\n","batch = torch.randint(0,batch_size,(1,)).item()\n","\n","axs[0].imshow(x[batch])\n","axs[0].set_title(f'x')\n","axs[0].set_xlabel('embed_dim')\n","axs[0].set_ylabel('seq_len')\n","\n","axs[1].imshow(out.detach()[batch])\n","axs[1].set_title(f'MHA (out)')\n","axs[1].set_xlabel('embed_dim')\n","\n","axs[2].imshow(x_ff.detach()[batch])\n","axs[2].set_title(f'Transformer Block (x_ff)')\n","axs[2].set_xlabel('embed_dim')\n","\n","_.suptitle(f'Batch: {batch}')\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":478},"id":"RRWusX9gVJWt","executionInfo":{"status":"ok","timestamp":1781637005469,"user_tz":-120,"elapsed":292,"user":{"displayName":"Adrian K","userId":"10865832628683391308"}},"outputId":"fdcc587e-d9c5-4769-fd06-d5df2f9aa98a"},"execution_count":23,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["# Language Model"],"metadata":{"id":"yJyB8QCRPngd"}},{"cell_type":"markdown","source":["## Code"],"metadata":{"id":"7hyDNgvlWAfT"}},{"cell_type":"code","source":["class LanguageModel(nn.Module):\n","  def __init__(self, gpu=True):\n","    super().__init__()\n","    self.gpu = gpu\n","\n","    # token + position embeddings\n","    self.wte = nn.Embedding(n_vocab, embed_dim) # token embedding\n","    self.wpe = nn.Embedding(seq_len, embed_dim) # position embedding\n","\n","    # transformer blocks\n","    self.transformer_blocks = nn.Sequential(*[TransformerBlock() for _ in range(n_blocks)])\n","\n","    # final layernorm\n","    self.layernorm_final = nn.LayerNorm(embed_dim, eps = 1e-5)\n","\n","    # lm head, with weights tied to token embedding\n","    self.final_head = nn.Linear(embed_dim, n_vocab, bias = False)\n","    self.final_head.weight = nn.Parameter(self.wte.weight)\n","\n","  def forward(self, idx):\n","\n","    # token + position embeddings (note the device!)\n","    token_emb = self.wte(idx) # [B, T, E]\n","    if self.gpu:\n","      posit_emb = self.wpe(torch.arange(idx.shape[-1], device = device)) # [T, E]\n","    else:\n","      posit_emb = self.wpe(torch.arange(idx.shape[-1])) # [T, E]\n","    x = token_emb + posit_emb # [B, T, E]\n","\n","    # pass through each transformer block\n","    x = self.transformer_blocks(x)\n","\n","    # final layernorm and unembeddings\n","    x = self.layernorm_final(x)\n","    logits = self.final_head(x) # [B, T, n_vocab]\n","\n","    return logits\n","\n","  def generate(self, idx, temperature = 1., max_new_tokens = 50):\n","\n","    for _ in range(max_new_tokens):\n","\n","      # forward pass\n","      logits = self(idx[:,-seq_len:]) # [B, T, n_vocab]\n","      logits = logits[:,-1,:] # last token's logits: [B, n_vocab]\n","\n","      # apply temperature + softmax\n","      probs = F.softmax(logits/temperature, dim = -1) # [B, n_vocab]\n","\n","      # sample next token\n","      idx_next = torch.multinomial(probs, num_samples = 1) # [B, 1]\n","\n","      # append\n","      idx = torch.cat((idx, idx_next), dim = 1) # [B, T+1]\n","\n","    return idx"],"metadata":{"id":"k8E9YVpbPpLX","executionInfo":{"status":"ok","timestamp":1781637005470,"user_tz":-120,"elapsed":0,"user":{"displayName":"Adrian K","userId":"10865832628683391308"}}},"execution_count":24,"outputs":[]},{"cell_type":"markdown","source":["## Test"],"metadata":{"id":"tEifHqyMUWuN"}},{"cell_type":"code","source":["language_model = LanguageModel().to(device)\n","language_model"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"o3gPl-HeXN3p","executionInfo":{"status":"ok","timestamp":1781637005912,"user_tz":-120,"elapsed":441,"user":{"displayName":"Adrian K","userId":"10865832628683391308"}},"outputId":"360efb23-4986-4625-eb80-c9d02f9fddc9"},"execution_count":25,"outputs":[{"output_type":"execute_result","data":{"text/plain":["LanguageModel(\n","  (wte): Embedding(50257, 768)\n","  (wpe): Embedding(1024, 768)\n","  (transformer_blocks): Sequential(\n","    (0): TransformerBlock(\n","      (layernorm_1): LayerNorm((768,), eps=1e-05, elementwise_affine=True)\n","      (attn): MultiHeadAttention(\n","        (QKV): Linear(in_features=768, out_features=2304,